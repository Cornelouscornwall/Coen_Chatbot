}

MILKS = ["regular", "oat", "almond", "soy"]

NUMBER_WORDS = {
    "one": 1,
    "two": 2,
    "three": 3,
    "four": 4,
    "five": 5,
    "six": 6,
    "seven": 7,
    "eight": 8,
    "nine": 9,
    "ten": 10,
    "eleven": 11,
    "twelve": 12
}


def get_tokens(sentence):
    """Lowercase and tokenise the user's sentence."""
    sentence = sentence.lower()
    return word_tokenize(sentence)


def lemmatise_tokens(tokens):
    """Lemmatise words so singular and plural forms can match."""
    lemmas = []

    for token in tokens:
        if token.isalpha():
            lemmas.append(lemmatizer.lemmatize(token))

    return lemmas


def number_from_word(word):
    """Turn a number or number word into an integer."""
    if word in NUMBER_WORDS:
        return NUMBER_WORDS[word]

    if word.isdigit():
        return int(word)

    return None


def get_size(tokens):
    """Find the requested size."""
    for token in tokens:
        if token in SIZES:
            return token

    return "medium"

    smtp_host = os.getenv("SMTP_HOST", "smtp.gmail.com")
    smtp_user = os.getenv("SMTP_USER", "devinc@pedarecc.sa.edu.au")
    smtp_pass = os.getenv("SMTP_PASS", "apfm erct wcgq nqpz")

        print(f"{number:>3}. {part_name} | SKU {sku} | {product_url}")

    choice = input("Enter a part number to open its VEX page, or press Enter to return: ").strip()
    if choice.isdigit() and 1 <= int(choice) <= len(links):
        product_url = links[int(choice) - 1][2]
        if webbrowser.open(product_url):
            print("Opening the VEX product page in your browser.")
        else:
            print(f"Could not launch a browser. Open this URL manually: {product_url}")


def add_to_cart(cart, part_name):
    """Add a chosen part to the shopping cart."""
    item = VEX_DATABASE[part_name]
    existing = next((row for row in cart if row["name"] == part_name), None)
    if existing:
        existing["quantity"] += 1
        return
    cart.append({
        "name": part_name,
        "sku": item["sku"],
        "price": item["price"],
        "category": item["category"],
        "quantity": 1,
        "product_url": item["product_url"],
        "quick_order_url": item["quick_order_url"],
    })


def calculate_total(cart):
    """Return the cart total."""
    return sum(item["price"] * item["quantity"] for item in cart)


def show_checkout(cart):
    """Display a final order summary and total."""
    total = calculate_total(cart)
    print("\nCHECKOUT")
    print("=" * 50)
    if not cart:
        print("There are no items in your order.")
        return total

    for item in cart:
        print(f"- {item['name']} x{item['quantity']} | SKU: {item['sku']} | ${item['price'] * item['quantity']:.2f}\n  VEX product page: {item['product_url']}\n  VEX Quick Order: {item['quick_order_url']}")
    print(f"\nTotal: ${total:.2f}")
    print("=" * 50)
    return total



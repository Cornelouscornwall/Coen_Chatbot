def print_cart(cart):
    """Show the cart contents clearly."""
    if not cart:
        print("Your cart is empty.")
        return

    print("\nCurrent cart:")
    for index, item in enumerate(cart, start=1):
        print(f"{index}. {item['name']} - SKU: {item['sku']} - ${item['price']:.2f}")


def add_to_cart(cart, part_name):
    """Add a chosen part to the shopping cart."""
    item = VEX_DATABASE[part_name]
    cart.append({
        "name": part_name,
        "sku": item["sku"],
        "price": item["price"],
        "category": item["category"],
    })


def calculate_total(cart):
    """Return the cart total."""
    return sum(item["price"] for item in cart)


def show_checkout(cart):
    """Display a final order summary and total."""
    total = calculate_total(cart)
    print("\nCHECKOUT")
    print("=" * 50)
    if not cart:
        print("There are no items in your order.")
        return total

    for item in cart:
        print(f"- {item['name']} | SKU: {item['sku']} | ${item['price']:.2f}")
    print(f"\nTotal: ${total:.2f}")
    print("=" * 50)
    return total



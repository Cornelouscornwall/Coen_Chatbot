def ask_question(prompt):
    """Keep asking until something is entered."""
    while True:
        answer = input(prompt)
        if answer.strip():
            return answer
        print(f"{BOT_NAME}: Please type a valid part name, SKU, or 'done'.")


def show_welcome():
    """Display the welcome banner."""
    print("=" * 60)
    print("Welcome to the VEX Smart Bot ordering system!")
    print("You can enter part names or SKUs to build your order.")
    print("Type 'links' to display product page links for the parts database.")
    print("Type 'done' when you are finished adding parts.")
    print("Type 'quit' to exit at any time.")
    print("=" * 60)


def main():
    """Run the VEX order flow."""
    show_welcome()
    cart = []

    while True:
        part_input = ask_question("\nWhat part would you like to order? (or type 'done'): ")
        if normalise_text(part_input) in EXIT_COMMANDS:
            print(f"{BOT_NAME}: Your order has been cancelled. Goodbye!")
            break

        if normalise_text(part_input) in {"links", "show links", "product links"}:
            display_product_links()
            continue

        if normalise_text(part_input) == "done":
            break

        matches = find_matching_parts(part_input)
        if not matches:
            print(f"{BOT_NAME}: I could not find that part. Try a VEX product name or SKU such as 'motor' or 'wheel'.")
            continue

        chosen_part = select_part_from_matches(part_input, matches)
        add_to_cart(cart, chosen_part)
        print(f"{BOT_NAME}: Added {chosen_part} to your order. The VEX product link is in your parts list.")
        print_cart(cart)

        another = input("Would you like to add another part? (yes/no): ")
        if normalise_text(another) in EXIT_COMMANDS:
            print(f"{BOT_NAME}: Your order has been cancelled. Goodbye!")
            break
        if normalise_text(another) in {"no", "n"}:
            break

    total = show_checkout(cart)
    if not cart:
        print(f"{BOT_NAME}: No items were added to your order.")
        return

    confirm = input("\nWould you like to confirm this order summary? (yes/no): ")
    if normalise_text(confirm) not in {"yes", "y"}:
        print(f"{BOT_NAME}: Order not confirmed. Thank you for using VEX Smart Bot.")
        return

    email_address = input("Please enter the email address to send the order summary: ").strip()
    while not re.fullmatch(r"[^\s@]+@[^\s@]+\.[^\s@]+", email_address):
        print(f"{BOT_NAME}: That email address is not valid.")
        email_address = input("Please enter a valid email address: ").strip()

    if send_order_email(email_address, cart, total):
        print(f"{BOT_NAME}: The order summary was emailed. You still need to place the order on VEX.")
    else:
        print(f"{BOT_NAME}: The order summary was not emailed. Use the VEX links above to place the order.")


if __name__ == "__main__":
    main()

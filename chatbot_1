def build_part_lookup():
    """Create keywords so database matching is easier."""
    lookup = {}
    for item_name, info in VEX_DATABASE.items():
        item_tokens = set(process_input(item_name)[2])
        lookup[item_name] = item_tokens
    return lookup


PART_LOOKUP = build_part_lookup()


def find_matching_parts(user_input):
    """Return all likely matches for a VEX part query, then let the user choose if needed."""
    cleaned, tokens, lemmas = process_input(user_input)
    lowered_query = cleaned.lower()
    if not cleaned:
        return []

    exact_sku = cleaned in {item["sku"] for item in VEX_DATABASE.values()}
    if exact_sku:
        for name, info in VEX_DATABASE.items():
            if info["sku"] == cleaned:
                return [name]

    matches = []
    for item_name, info in VEX_DATABASE.items():
        item_lower = item_name.lower()
        item_lemmas = set(process_input(item_name)[2])

        score = 0
        if cleaned == item_name:
            score += 100
        if lowered_query in item_lower:
            score += 30
        if item_lower.startswith(lowered_query):
            score += 20
        if any(token in item_lower for token in cleaned.split()):
            score += 10
        if cleaned in item_lower or item_lower in cleaned:
            score += 15
        score += sum(1 for lemma in lemmas if lemma in item_lemmas)

        if score > 0:
            matches.append((score, item_name))

    if not matches:
        return []

    matches = sorted(matches, key=lambda entry: (-entry[0], len(entry[1]), entry[1]))
    unique_matches = []
    seen = set()
    for _, item_name in matches:
        if item_name not in seen:
            unique_matches.append(item_name)
            seen.add(item_name)

    return unique_matches


def find_part(user_input):
    """Keep compatibility with older logic by returning the first best match."""
    matches = find_matching_parts(user_input)
    return matches[0] if matches else None


def select_part_from_matches(user_input, matches):
    """Ask the user to choose one item from a list of matching parts."""
    if len(matches) == 1:
        return matches[0]

    print(f"{BOT_NAME}: I found {len(matches)} parts matching '{user_input}'.")
    for index, item_name in enumerate(matches[:10], start=1):
        info = VEX_DATABASE[item_name]
        print(f"  {index}. {item_name} - SKU: {info['sku']} - ${info['price']:.2f}")

    if len(matches) > 10:
        print(f"  ... and {len(matches) - 10} more matches.")

    while True:
        choice = input("Please enter the number of the item you want to select: ").strip()
        if choice.isdigit():
            choice_index = int(choice) - 1
            if 0 <= choice_index < len(matches):
                return matches[choice_index]
        print(f"{BOT_NAME}: That selection is not valid. Please choose a number from the list.")



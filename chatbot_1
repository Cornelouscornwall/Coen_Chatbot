# 3. TEXT PROCESSING
# ---------------------------------------------------------------------------

def normalise_text(text):
    """Lowercase text and remove extra spacing."""
    if not isinstance(text, str):
        text = str(text)
    text = text.lower().strip()
    text = text.replace("’", "'")
    text = text.replace("doesn't", "doesnt")
    text = text.replace("can't", "cannot")
    text = re.sub(r"\s+", " ", text)
    return text


def remove_punctuation(text):
    """Remove punctuation while keeping words readable."""
    return text.translate(str.maketrans({char: " " for char in string.punctuation}))


def tokenise_text(text):
    """Split the sentence into a list of words using NLTK."""
    try:
        return word_tokenize(text)
    except LookupError:
        return re.findall(r"\b[\w']+\b", text)


def lemmatise_tokens(tokens):
    """Reduce words to simple dictionary form."""
    lemmas = []
    for token in tokens:
        if token.isalpha():
            base = lemmatizer.lemmatize(token, pos="v")
            if base == token:
                base = lemmatizer.lemmatize(token, pos="n")
            lemmas.append(base)
        else:
            lemmas.append(token)
    return lemmas


def process_input(user_input):
    """Return the cleaned input, tokens and lemmas for matching."""
    cleaned = normalise_text(user_input)
    no_punctuation = remove_punctuation(cleaned)
    tokens = tokenise_text(no_punctuation)
    lemmas = lemmatise_tokens(tokens)
    return cleaned, tokens, lemmas



# 3. TEXT PROCESSING
# ---------------------------------------------------------------------------

def normalise_text(text):
    """Lowercase text and remove extra spacing."""
    if not isinstance(text, str):
        text = str(text)
    text = text.lower().strip()
    text = text.replace("’", "'")
    text = text.replace("doesn't", "doesnt")
    text = text.replace("can't", "cannot")
    text = re.sub(r"\s+", " ", text)
    return text


def remove_punctuation(text):
    """Remove punctuation while keeping words readable."""
    return text.translate(str.maketrans({char: " " for char in string.punctuation}))


def tokenise_text(text):
    """Use NLTK tokenization when installed, with a dependency-free fallback."""
    if nltk_word_tokenize:
        try:
            # preserve_line avoids requiring downloaded Punkt models.
            return nltk_word_tokenize(text, preserve_line=True)
        except LookupError:
            pass
    return re.findall(r"\b[\w']+\b", text)


def lemmatise_tokens(tokens):
    """Use WordNet lemmatisation, then NLTK stemming if WordNet is unavailable."""
    lemmas = []
    for token in tokens:
        if token.isalpha():
            base = token
            if _wordnet_lemmatizer:
                try:
                    base = _wordnet_lemmatizer.lemmatize(token, pos="v")
                    if base == token:
                        base = _wordnet_lemmatizer.lemmatize(token, pos="n")
                except LookupError:
                    base = _porter_stemmer.stem(token) if _porter_stemmer else token
            elif _porter_stemmer:
                base = _porter_stemmer.stem(token)
            else:
                if len(token) > 4 and token.endswith("ies"):
                    base = token[:-3] + "y"
                elif len(token) > 4 and token.endswith("s") and not token.endswith("ss"):
                    base = token[:-1]
                elif len(token) > 5 and token.endswith("ing"):
                    base = token[:-3]
            lemmas.append(base)
        else:
            lemmas.append(token)
    return lemmas


def process_input(user_input):
    """Return the cleaned input, tokens and lemmas for matching."""
    cleaned = normalise_text(user_input)
    no_punctuation = remove_punctuation(cleaned)
    tokens = tokenise_text(no_punctuation)
    lemmas = lemmatise_tokens(tokens)
    return cleaned, tokens, lemmas


